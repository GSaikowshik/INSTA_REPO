PROJECT_NAME="Insta Repo API"
API_V1_STR="/api/v1"
SECRET_KEY="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=insta_repo
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/insta_repo

# Google Gemini API Key
GEMINI_API_KEY="your_gemini_api_key_here"

# Clerk Webhook Secret (from Clerk Dashboard -> Webhooks -> Signing Secret)
CLERK_WEBHOOK_SIGNING_SECRET="whsec_your_clerk_webhook_signing_secret"

